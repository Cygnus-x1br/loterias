# Estágio 1: Build do Frontend (Node e Vite)
FROM node:20-alpine AS frontend-build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

# Estágio 2: Build do Backend (PHP 8.3 FPM + Nginx)
FROM php:8.3-fpm-alpine

# Instala pacotes do sistema
RUN apk add --no-cache \
    nginx \
    zip \
    libzip-dev \
    unzip \
    curl \
    mariadb-client \
    git \
    oniguruma-dev \
    icu-dev

# Instala extensões do PHP necessárias para o Laravel
RUN docker-php-ext-install pdo_mysql mbstring zip exif pcntl bcmath intl

# Instala Composer
COPY --from=composer:2.7 /usr/bin/composer /usr/bin/composer

# Configuração do Nginx
COPY docker/nginx/default.prod.conf /etc/nginx/http.d/default.conf

WORKDIR /var/www/html

# Copia os arquivos do projeto
COPY . .

# Copia os assets buildados do Node (Estágio 1)
COPY --from=frontend-build /app/public/build /var/www/html/public/build

# Instala as dependências do PHP (sem os pacotes de dev) e otimiza o autoloader
RUN composer install --no-dev --optimize-autoloader --no-interaction

# Ajusta as permissões das pastas que o Laravel precisa escrever
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 775 /var/www/html/storage \
    && chmod -R 775 /var/www/html/bootstrap/cache

# Adiciona e configura o script de inicialização
COPY docker/entrypoint.prod.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Expõe a porta 80 do Nginx
EXPOSE 80

# O entrypoint roda as migrations, limpa o cache e sobe o Nginx e o PHP-FPM
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
